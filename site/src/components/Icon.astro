---
interface Props { name: 'board' | 'flag' | 'table' | 'screen' | 'disc' | 'globe' | 'vm' | 'lan' | 'tunnel' | 'vpn' }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'board' && (<><rect x="4" y="5" width="24" height="22" rx="2" /><path d="M10 21v-5M16 21V11M22 21v-8" /></>)}
  {name === 'flag' && (<><path d="M8 28V5" /><path d="M8 6h15l-3 5 3 5H8" /></>)}
  {name === 'table' && (<><rect x="4" y="6" width="24" height="20" rx="2" /><path d="M4 12h24M4 19h24M13 6v20" /></>)}
  {name === 'screen' && (<><rect x="4" y="5" width="24" height="17" rx="2" /><path d="M12 27h8M16 22v5" /><circle cx="16" cy="12" r="2.6" /><path d="M11.5 19c.9-2 2.6-3 4.5-3s3.6 1 4.5 3" /></>)}
  {name === 'disc' && (<><circle cx="16" cy="16" r="11" /><circle cx="16" cy="16" r="3" /><path d="M16 5a11 11 0 0 1 11 11" /></>)}
  {name === 'globe' && (<><circle cx="16" cy="16" r="11" /><path d="M5 16h22M16 5c3 3.2 4.5 6.8 4.5 11S19 23.8 16 27c-3-3.2-4.5-6.8-4.5-11S13 8.2 16 5z" /></>)}
  {name === 'vm' && (<><rect x="5" y="7" width="22" height="14" rx="2" /><rect x="9" y="11" width="14" height="6" rx="1" /><path d="M11 25h10" /></>)}
  {name === 'lan' && (<><rect x="13" y="4" width="6" height="5" rx="1" /><rect x="4" y="23" width="6" height="5" rx="1" /><rect x="13" y="23" width="6" height="5" rx="1" /><rect x="22" y="23" width="6" height="5" rx="1" /><path d="M16 9v8M7 23v-6h18v6M16 17v6" /></>)}
  {name === 'tunnel' && (<><circle cx="7" cy="16" r="3" /><circle cx="25" cy="9" r="3" /><circle cx="25" cy="23" r="3" /><path d="M10 15l12-5M10 17l12 5" /></>)}
  {name === 'vpn' && (<><rect x="8" y="14" width="16" height="13" rx="2" /><path d="M11 14v-3a5 5 0 0 1 10 0v3" /><path d="M16 19v3" /></>)}
</svg>
