---
import Base from '../layouts/Base.astro';
import { config, expandir } from '../../src/config.js';
import { textos } from '../../src/i18n.js';
import { leerBase, leerCatalogo, leerCatalogoInstructor, leerDias, fichaDe } from '../../src/datos.js';

const usuario = Astro.locals.usuario ?? null;
const idioma = Astro.locals.idioma ?? config.idioma;
const t = textos(idioma);
const esProfe = Boolean(usuario?.esInstructor);

const [db, retos, diasCurso] = await Promise.all([leerBase(), leerCatalogo(idioma), leerDias(idioma)]);

const detalle = new Map<string, { donde: string; pista: string }>();
if (esProfe) {
  for (const r of await leerCatalogoInstructor(idioma)) detalle.set(r.id, { donde: r.donde, pista: r.pista });
}

const resueltosPorReto = new Map<string, number>();
for (const f of Object.values(db.Alumnos)) {
  for (const id of Object.keys(f.Resueltos ?? {})) resueltosPorReto.set(id, (resueltosPorReto.get(id) ?? 0) + 1);
}

const mia = usuario ? fichaDe(db, usuario.slot, usuario.sam) : null;
const mios = new Set<string>(Object.keys(mia?.Resueltos ?? {}));
const participantes = Object.keys(db.Alumnos).length;
const titulos = new Map(diasCurso.map((d) => [d.dia, d.titulo]));
const numeros = [...new Set(retos.map((r) => r.dia))].sort((a, b) => a - b);

const grupos = numeros.map((d) => {
  const lista = retos.filter((r) => r.dia === d).map((r) => ({
    ...r,
    profe: detalle.get(r.id) ?? null,
    resueltos: resueltosPorReto.get(r.id) ?? 0,
    primero: db.PrimerasSangres?.[r.id] ?? null,
    mio: mios.has(r.id),
  }));
  return {
    dia: d,
    titulo: titulos.get(d) ?? '',
    lista,
    puntos: lista.filter((r) => !r.opcional).reduce((s, r) => s + r.puntos, 0),
    obligatorios: lista.filter((r) => !r.opcional).length,
    opcionales: lista.filter((r) => r.opcional).length,
  };
});

const totalObligatorio = grupos.reduce((s, g) => s + g.puntos, 0);
const totalOpcional = retos.filter((r) => r.opcional).reduce((s, r) => s + r.puntos, 0);
const comprobados = retos.filter((r) => r.tipo === 'check').map((r) => r.id);
---
<Base titulo={t.retos.titulo} activo="retos" refrescoSeg={60}>
  <header class="mb-10">
    <p class="ceja">{config.laboratorio} · {t.retos.seccion}<span class="cursor"></span></p>
    <h1 class="titulo-serif text-4xl sm:text-5xl mt-4">{t.retos.titulo}</h1>
    <p class="text-mudo text-xs mt-3">{t.retos.sub(retos.length, totalObligatorio, totalOpcional)}</p>
  </header>

  {retos.length === 0 && <div class="panel aviso-info">{t.retos.sinCatalogo}</div>}

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
    <div class="min-w-0 space-y-6">
      {grupos.map((g) => (
        <section class="panel p-4 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
            <h2 class="flex items-baseline gap-4">
              <span class="nfo">[ {String(g.dia).padStart(2, '0')} ]</span>
              <span class="font-serif text-2xl text-tinta" style="letter-spacing:0.04em">{g.titulo || t.retos.dia(g.dia)}</span>
            </h2>
            <span class="text-mudo text-xs">
              {t.retos.resumen(g.obligatorios, g.puntos)}{g.opcionales > 0 && <> · {t.retos.opcionales(g.opcionales)}</>}
            </span>
          </div>
          <ul>
            {g.lista.map((r) => (
              <li class="py-4 border-b border-borde/15 last:border-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <code class:list={['shrink-0 text-xs', r.mio ? 'text-neon' : 'text-cian/90']}>{r.id}</code>
                  <span class="text-tinta text-dato font-normal">{r.titulo}</span>
                  {r.opcional && <span class="etiqueta bg-ambar/10 text-ambar">{t.retos.opcional}</span>}
                  {r.tipo === 'check' && <span class="etiqueta bg-violeta/10 text-violeta">{t.retos.comprobado}</span>}
                  {r.tipo === 'deliverable' && <span class="etiqueta bg-jade-hondo/25 text-jade-claro">{t.retos.entrega}</span>}
                  {r.mio && <span class="etiqueta bg-neon/10 text-neon">{t.retos.resuelto}</span>}
                  <span class="text-jade-claro text-dato ml-auto shrink-0">{t.retos.pts(r.puntos)}</span>
                </div>
                {r.pistaPublica && <p class="text-tenue text-dato mt-2 leading-relaxed">{r.pistaPublica}</p>}
                {r.profe && (
                  <details class="mt-3 border-l border-violeta/50 pl-4">
                    <summary class="text-violeta text-xs cursor-pointer select-none uppercase" style="letter-spacing:0.14em">{t.retos.solucion}</summary>
                    <div class="mt-2 text-xs leading-relaxed space-y-1">
                      {r.profe.donde && <p class="text-tenue"><span class="text-mudo">{t.retos.donde}:</span> <code class="text-violeta">{r.profe.donde}</code></p>}
                      {r.profe.pista && <p class="text-tenue"><span class="text-mudo">{t.retos.pista}:</span> {r.profe.pista}</p>}
                    </div>
                  </details>
                )}
                <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-xs text-mudo">
                  <span>{t.retos.cuantos(r.resueltos, participantes)}</span>
                  {r.primero && <span class="text-ambar">{t.retos.primera(r.primero)}</span>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <aside class="min-w-0 space-y-6">
      <section class="panel p-5 sm:p-6">
        <h2 class="titulo-panel mb-4"><span class="nfo">[ 0x01 ]</span>{t.puntuacion.titulo}</h2>
        <ul class="text-dato text-tenue leading-relaxed space-y-3">
          {t.puntuacion.items.map((i) => <li class="vineta">{i}</li>)}
          <li class="vineta vineta-rosa text-rosa">{t.puntuacion.castigo}</li>
        </ul>
      </section>
      <section class="panel p-5 sm:p-6 text-dato text-tenue leading-relaxed">
        <h2 class="titulo-panel mb-4"><span class="nfo">[ 0x02 ]</span>{t.retos.noTodo}</h2>
        {comprobados.length > 0 && <p class="mb-3">{expandir(t.retos.noTodo1(comprobados.join(', ')))}</p>}
        <p>{expandir(t.retos.noTodo2)}</p>
      </section>
    </aside>
  </div>
</Base>
